#define ShapesPI 3.14159265359
/**
 * Creates an anti-aliased border around a distance-based shape.
 *
 * @param dist       Distance from the shape's center or origin.
 * @param borderSize Thickness of the border.
 * @param shapeSize  Radius or size of the shape's outer boundary.
 * @param edgeSmooth Width of the anti-aliasing transition.
 * @return           A mask value between 0.0 and 1.0.
 */
float borderShape(float dist, float borderSize, float shapeSize, float edgeSmooth) {
    float halfBorder = borderSize * 0.5;

    float outer = 1.0 - smoothstep(
        shapeSize + halfBorder - edgeSmooth,
        shapeSize + halfBorder,
        dist
    );

    float inner = smoothstep(
        shapeSize - halfBorder - edgeSmooth,
        shapeSize - halfBorder,
        dist
    );

    return outer * inner;
}

/**
 * Creates a filled, anti-aliased shape mask.
 *
 * @param dist       Distance from the shape's center or origin.
 * @param shapeSize  Radius or size of the shape's boundary.
 * @param edgeSmooth Width of the anti-aliasing transition.
 * @return           A mask value between 0.0 and 1.0.
 */
float filledShape(float dist, float shapeSize, float edgeSmooth) {
    return 1.0 - smoothstep(shapeSize - edgeSmooth, shapeSize, dist);
}

/**
 * Creates a filled shape with alternating stripes.
 *
 * @param dist           Distance from the shape's center or origin.
 * @param shapeSize      Radius or size of the shape's boundary.
 * @param stripeFrequency Number of stripe cycles per distance unit.
 * @param edgeSmooth     Width of the shape's anti-aliasing transition.
 * @param adjust         Phase offset that shifts the stripe pattern.
 * @return               A striped mask clipped to the shape boundary.
 */
float stripedShape(
    float dist,
    float shapeSize,
    float stripeFrequency,
    float edgeSmooth,
    float adjust
) {
    float baseShape = filledShape(dist, shapeSize, edgeSmooth);
    float stripes = step(0.5, fract(dist * stripeFrequency + adjust));

    return baseShape * stripes;
}

/**
 * Selects a shape rendering style.
 *
 * @param dist       Distance from the shape's center or origin.
 * @param style      Style selector: 0 = filled, 1 = bordered, 2 = striped.
 * @param shapeSize  Radius or size of the shape's boundary.
 * @param borderSize Thickness of the border; used by style 1.
 * @param stripeFreq Stripe frequency; used by style 2.
 * @param edgeSmooth Width of the anti-aliasing transition.
 * @param adjust     Phase offset for the stripe pattern.
 * @return           The mask generated by the selected style, or 0.0
 *                   if the style is unsupported.
 */
float variantShape(
    float dist,
    int style,
    float shapeSize,
    float borderSize,
    float stripeFreq,
    float edgeSmooth,
    float adjust
) {
    if (style == 0) {
        return filledShape(dist, shapeSize, edgeSmooth);
    } else if (style == 1) {
        return borderShape(dist, borderSize, shapeSize, edgeSmooth);
    } else if (style == 2) {
        return stripedShape(dist, shapeSize, stripeFreq, edgeSmooth, adjust);
    }

    return 0.0;
}

/**
 * Creates a filled shape using the default style.
 *
 * @param dist       Distance from the shape's center or origin.
 * @param shapeSize  Radius or size of the shape's boundary.
 * @param edgeSmooth Width of the anti-aliasing transition.
 * @return           A filled shape mask between 0.0 and 1.0.
 */
float variantShape(float dist, float shapeSize, float edgeSmooth) {
    return filledShape(dist, shapeSize, edgeSmooth);
}

/**
 * Creates a bordered shape using the default style.
 *
 * @param dist       Distance from the shape's center or origin.
 * @param shapeSize  Radius or size of the shape's outer boundary.
 * @param borderSize Thickness of the border.
 * @param edgeSmooth Width of the anti-aliasing transition.
 * @return           A bordered shape mask between 0.0 and 1.0.
 */
float variantShape(float dist, float shapeSize, float borderSize, float edgeSmooth) {
    return borderShape(dist, borderSize, shapeSize, edgeSmooth);
}

/**
 * Converts UV coordinates into a normalized angle.
 *
 * The angle is mapped to the range [0.0, 1.0], making it
 * useful for radial patterns and angular effects.
 *
 * @param uv 2D coordinate used to calculate the angle.
 * @return   Normalized angle in the range [0.0, 1.0].
 */
float getAngle(vec2 uv) {
    return atan(uv.y, uv.x) / (PI * 2.0) + 0.5;
}

/**
 * Calculates a signed distance field for an equilateral triangle.
 *
 * The triangle is centered around the origin and mirrored
 * across the Y axis to maintain left-right symmetry.
 *
 * @param uv 2D coordinate relative to the triangle's center.
 * @return   Signed distance approximation to the triangle boundary.
 */
float triangleField(vec2 uv) {
    uv.x = abs(uv.x);

    vec2 edgeNormal = vec2(0.866025, 0.5);

    float sides = dot(uv, edgeNormal);
    float bottom = -uv.y;

    return max(sides, bottom);
}

/**
 * Calculates the radial distance from the origin.
 *
 * @param uv 2D coordinate relative to the circle's center.
 * @return   Euclidean distance from the origin.
 */
float circleField(vec2 uv) {
    return length(uv);
}

/**
 * Calculates a square distance field using the maximum
 * absolute coordinate.
 *
 * @param uv 2D coordinate relative to the rectangle's center.
 * @return   Chebyshev distance from the origin.
 */
float rectangleField(vec2 uv) {
    return max(abs(uv.x), abs(uv.y));
}

/**
 * Creates a circular distance field with sinusoidal radial waves.
 *
 * @param uv         2D coordinate relative to the circle's center.
 * @param waveCount  Number of radial wave cycles around the circle.
 * @param waveHeight Amplitude of the radial displacement.
 * @param adjust     Phase offset applied to the angular pattern.
 * @return           Modified radial distance for the waved circle.
 */
float wavedCircleField(vec2 uv, float waveCount, float waveHeight, float adjust) {
    float angle = getAngle(uv) + adjust;
    float radius = sin(angle * PI * 2.0 * waveCount) * waveHeight;

    return circleField(uv) + radius;
}


/**
 * Creates a cog-shaped circular distance field with evenly spaced teeth.
 *
 * @param uv         2D coordinate relative to the circle's center.
 * @param teethCount Number of teeth distributed around the circle.
 * @param teethHeight Height of the radial displacement for each tooth.
 * @param teethWidth Controls the width of the teeth by setting the
 *                   threshold applied to the sinusoidal pattern.
 * @param adjust     Phase offset used to rotate the tooth pattern.
 * @return           Modified radial distance that creates a cog shape.
 */
float cogCircleField(
    vec2 uv,
    float teethCount,
    float teethHeight,
    float teethWidth,
    float adjust
) {
    float threshold = 1.0 - 2.0 * teethWidth;
    float angle = getAngle(uv) + adjust;
    float radius = step(
        threshold,
        sin(angle * PI * 2.0 * teethCount)
    ) * teethHeight * -1.0;

    return circleField(uv) + radius;
}

/**
 * Calculates a polygonal distance field with a configurable side count.
 *
 * @param uv     2D coordinate relative to the polygon's center.
 * @param sides  Number of polygon sides.
 * @param adjust Phase offset used to rotate the polygon.
 * @return       Radial distance adjusted to create a regular polygon shape.
 */
float polygonField(vec2 uv, int sides, float adjust) {
    float d = 0.0;

    float a = atan(uv.x, uv.y) + 3.14 + adjust;
    float r = 3.14 * 2.0 / float(sides);

    d = cos(floor(0.5 + a / r) * r - a) * length(uv);

    return d;
}



float verticalStripes(vec2 uv, float stripCount, float stripeSize){
    //-------------------------------
      //verticalStripes function returns float values for vertical stripe shape. 
      //@param {vec2} uv : texture uv
      //@param {float} stripCount : stripe Count  
      //@returns {float} stripeSize : stripe Width
    //--------------------------------
    float strength = step(stripeSize, mod(uv.y * stripCount, 1.0));
    return strength;
}

float circularStripes(vec2 uv, vec2 centerPoint, float stripeCount, float stripeSize, float adjust){
    //-------------------------------
      //circularStripes function returns float values for circular Stripes stripe shape. 
      //@param {vec2} uv : texture uv
      //@param {vec2} centerPoint : stripe origin X Y
      //@param {float} stripCount : stripe Count  
      //@returns {float} stripeSize : stripe Width
      //@returns {float} adjust : adjust stripe position
    //--------------------------------
   
    return step(stripeSize, fract(length(uv - centerPoint) * stripeCount + adjust));
}



vec2 rotateUV(vec2 uv, float rotation, vec2 mid){
    //-------------------------------
      //rotateUV function returns vec2 value for rotated UV. 
      //@param {vec2} uv : texture uv
      //@param {float} rotation: aotation angle
      //@param {vec2} mid: rotate oriantion of X and Y
    //--------------------------------
    return vec2(
      cos(rotation) * (uv.x - mid.x) + sin(rotation) * (uv.y - mid.y) + mid.x,
      cos(rotation) * (uv.y - mid.y) - sin(rotation) * (uv.x - mid.x) + mid.y
    );
}




float plusShape( vec2 uv){
    //-------------------------------
      //plusShape function returns float values for plus shape. 
      //@param {vec2} uv : texture uv
    //--------------------------------
    float boxX = step(0.4, mod(uv.x  - 0.2, 1.0)) *  step(0.8, mod(uv.y , 1.0));
    float boxY = step(0.8, mod(uv.x , 1.0)) *  step(0.4, mod(uv.y  - 0.2, 1.0));
    float strength = boxX + boxY;
    return strength;
}


float cornerShape(vec2 uv, float inverse){
    //-------------------------------
      //cornerShape function returns float values for rop right and bottom right corner shape pattern. 
      //@param {vec2} uv : texture uv
      //@param {float} inverse : 0.0 = top right corner, 1.0 = bottom left corner  
    //--------------------------------
    if(inverse == 1.0){
       uv = 1.0 - uv; 
    }
    float boxX = step(0.4, mod( uv.x , 1.0)) *  step(0.8, mod( uv.y , 1.0));
    float boxY = step(0.8, mod( uv.x , 1.0)) *  step(0.4, mod( uv.y , 1.0));
    float strength = boxX + boxY ;
    return strength;
}

float borderBoxShape(vec2 uv, float boxSize, vec2 pos, float borderWidth){
    //-------------------------------
      //borderBoxShape function returns float values for border box shape. 
      //@param {vec2} uv : texture uv
      //@param {float} boxSize: box size
      //@param {vec2}  pos : box position X,Y
      //@param {float} borderWidth: border width
    //--------------------------------
    float strength = step(boxSize, max(abs(uv.x - pos.x), abs(uv.y - pos.y))) ;
    strength *= 1.0 - step(boxSize + borderWidth, max(abs(uv.x - pos.x), abs(uv.y - pos.y)));
    return strength;
}

float shades(vec2 uv, float shadeSize){
     //-------------------------------
      //shades function returns float values for X and Y dark light shades. 
      //@param {vec2} uv - texture uv
      //@param {float} shadeSize: shade size
    //--------------------------------
    return floor(uv.x * shadeSize) * 0.1 * floor(uv.y * shadeSize) * 0.1;
}

float randomShades(vec2 uv, float shadeSize,  float rotationY){
     //-------------------------------
      //randomShades function returns random dark light shades value with Y axis rotation. 
      //@param {vec2} uv : texture uv
      //@param {float} shadeSize: shade size
      //@param {float} rotationY: rotation Y
    //--------------------------------
    vec2 gridUv = vec2(floor(uv.x * shadeSize) / shadeSize , floor( (uv.y + uv.x * rotationY) * shadeSize) / shadeSize);
    float strength = randomFloat2D(gridUv);
    return strength;
}

float starDot(vec2 uv, float intensity , vec2 centerPoint, float sqX, float sqY){
    //-------------------------------
      //starDot function returns float value for glowing dot shape. 
      //@param {vec2} uv : texture uv
      //@param {float} intensity: glow amount
      //@param {vec2} centerPoint: dot position X Y
      //@param {float} sqX: strech on X axis
      //@param {float} sqY: strech on Y axis
    //--------------------------------
    return  intensity / distance(vec2( (uv.x - 0.5) * sqY + 0.5, (uv.y - 0.5) * sqX + 0.5 ), centerPoint) ;
}

float starShape(vec2 uv, float intensity, vec2 centerPoint, float sqX, float sqY){
    //-------------------------------
      //starShape function returns float value for star shape. 
      //@param {vec2} uv : texture uv
      //@param {float} intensity: glow amout of star
      //@param {vec2} centerPoint: position of star X and Y
      //@param {float} sqX: strech on X axis
      //@param {float} sqY: strech on Y axis
    //--------------------------------
   return starDot(uv, intensity, centerPoint, sqX, sqY) * starDot(uv, intensity, centerPoint, sqY, sqX );
}

float starShape1(vec2 uv){
    //-------------------------------
      //starShape1 function returns float values for star shape. 
      //@param {vec2} uv : texture uv
    //--------------------------------
   return smoothstep(0.001, 0.99,  max(abs(uv.x), abs(uv.y)) ) ;
}
float circleShape(vec2 uv, vec2 circlePos){
    //-------------------------------
      //circleShape function returns circle shape. 
      //@param {vec2} uv : texture uv
      //@param {vec2} circlePos: circle position X Y
    //--------------------------------
    return distance(uv, circlePos);
}
float borderShape(float shapeStrength, float borderSize, float shapeSize){
    //-------------------------------
      //borderShape function returns border version of shape. 
      //@param {float} shapeStrength : shape values
      //@param {float} borderSize: border size
      //@param {float} shapeSize: shape size
    //--------------------------------
    return step(shapeSize - borderSize, shapeStrength) * step(shapeStrength, shapeSize );
    
}

float wavedCircle( 
    vec2 uv, 
    float circleSize, 
    vec2 circlePos, 
    float waveCount, 
    float waveHeight,
    float angle
){
     //-------------------------------
      //wavedCircle function returns float value for waved circle shape. 
      //@param {vec2} uv : texture uv
      //@param {float} circleSize: circle size
      //@param {vec2} circlePos: circle position X Y
      //@param {float} waveCount: how much waves
      //@param {float} waveHeight: height of waves
      //@param {float} angle: circle angle
    //--------------------------------
    float dist = length(uv - circlePos) - circleSize;
    float radius =  sin(angle * PI * 2.0 * waveCount) * max(waveHeight, 0.01);
    float circle = dist / max(waveHeight, 0.01) + radius;
    return circle;
}


float angle360dStripe(vec2 uv, float angle, float stripeCount){
    //-------------------------------
      //angle360dStripe function returns float value for angled circle.
      //valus at 0 angle is near to 0 and values at to 6.28 angle is near to 1 
      //@param {vec2} uv : texture uv
      //@param {vec2} angle: angle value
      //@param {float} stripeCount: devide ciecle according to stripeCount
    //--------------------------------

    return fract(angle * max(stripeCount,1.0) )  ;

}

float stripedStrenth(float strength, float stripeSize, float stripeCount, float adjust){
    //-------------------------------
      //stripedStrenth function returns float value for stripe shape of provided strength.
      //@param {float} strength : strength of any shape
      //@param {float} stripeSize: stripe size
      //@param {float} stripeCount: amount of stripes
      //@param {float} adjust: stripe adjust value (may use for forward or backward animation)
    //--------------------------------
    return step(stripeSize,fract(strength * stripeCount + adjust));
}